  <script nonce="i2qWbse5yjLLPLuWqfIY">
  (function () {
    var overlay = document.getElementById('AliyunConsoleOverlay');
    if (!overlay) return;
    var p = location.pathname, h = location.hash;
    var isLanding = (p === '/' || p === '') && (h === '' || h === '#' || h === '#/');
    if (isLanding) {
      // 首页由 first-screen.js 直接画静态首屏：只保留同色底，不显示 loading
      overlay.innerHTML = '';
      overlay.style.background = '#fafafc';
      return;
    }
    overlay.innerHTML = '<img style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%)" width="32" height="32" src="https://img.alicdn.com/imgextra/i2/O1CN01JiWo7t1xljFrksp6L_!!6000000006484-55-tps-192-192.svg" />';
  })();
</script> 
