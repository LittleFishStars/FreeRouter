  // 旧独立域名 → 合域后的主域名 + region 段
  var RULES = [
    { from: 'bailian.console.alibabacloud.com', to: 'modelstudio.console.alibabacloud.com', region: 'cn-beijing' },
    { from: 'modelstudio.console.aliyun.com',   to: 'bailian.console.aliyun.com',           region: 'ap-southeast-1' }
  ];
 
  // 预发域名带 pre- 前缀，目标同样保留（对齐 legacy-redirect 的 stage 语义）
  var stage = loc.hostname.indexOf('pre-') === 0 ? 'pre-' : '';
  var rule = null;
  for (var i = 0; i < RULES.length; i++) {
    if (loc.hostname === stage + RULES[i].from) { rule = RULES[i]; break; }
  }
  if (!rule) return;
 
  // pathname 首段已是目标 region 时不重复插入
  var path = loc.pathname;
  if (path !== '/' + rule.region && path.indexOf('/' + rule.region + '/') !== 0) {
    path = '/' + rule.region + (path.charAt(0) === '/' ? path : '/' + path);
  }
 
  loc.replace(loc.protocol + '//' + stage + rule.to + path + loc.search + loc.hash);
})();
</script> 
