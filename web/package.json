{
  "name": "freerouter-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "FreeRouter 控制台前端（Vite + React + TypeScript）。构建产物落到 ../internal/webui/dist，由 Go 侧 go:embed 打进单二进制。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "i": "XDG_RUNTIME_DIR=/tmp pnpm install --store-dir .pnpm-store",
    "clean": "rm -rf ../internal/webui/dist"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
